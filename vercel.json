{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/yfin/:path*", "destination": "https://query1.finance.yahoo.com/:path*" },
    { "source": "/yfin2/:path*", "destination": "https://query2.finance.yahoo.com/:path*" },
    { "source": "/fh/:path*", "destination": "https://finnhub.io/:path*" },
    { "source": "/cg/:path*", "destination": "/api/cg/:path*" },
    { "source": "/fx/:path*", "destination": "https://open.er-api.com/:path*" },
    { "source": "/ecb-api/:path*", "destination": "https://data-api.ecb.europa.eu/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
