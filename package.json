{
  "name": "nexus-dashboard",
  "version": "1.13.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:ime": "node scripts/check-ime.mjs",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "build": "tsc -b && vite build",
    "lint": "node scripts/check-ime.mjs && eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "icons": "node scripts/build-icons.mjs && capacitor-assets generate --android",
    "electron:dev": "electron .",
    "electron:build": "npm run build && node electron/build.cjs --win && npm run electron:zip",
    "electron:zip": "node electron/package-zip.cjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@devmaxime/capacitor-health-connect": "^1.1.0",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.7.7",
    "dexie": "^4.0.8",
    "i18next": "^23.16.8",
    "lucide-react": "^0.414.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.limecore.nexus.desktop",
    "productName": "Nexus Command Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NexusCommandCenter-Desktop-Setup-${version}.${ext}"
    }
  }
}
